# Copy to .env (never commit .env) and fill in your own values.
# Spring Boot does not read .env automatically: export these variables in your shell,
# or load the file with your IDE run configuration.

# Required: HMAC key for signing JWTs, at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRATION=1h

# MySQL
DB_URL=jdbc:mysql://localhost:3306/RestApiDB?createDatabaseIfNotExist=true
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# Cloudinary (optional - profile photo uploads are disabled when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=8080
